    {
      "parameters": {
        "chatId": "={{ $('Extract user data').item.json.chat_id }}",
        "text": "=hello  {{ $('Extract user data').item.json.user_name }}\nWelcome to our Customer Support Bot. I can help you with:\n\n🔍 Order Status - Type your order number\n❓ FAQ - Common questions and answers\n📞 Contact Support - Connect with human agent\n💳 Billing - Billing and payment questions\n🚚 Shipping - Delivery information\n\nJust type what you need help with, or use these commands:\n\n• /faq - View frequently asked questions\n• /contact - Speak to human support\n• /status - Check order status\n\nHow can I assist you today?\n",
        "additionalFields": {
          "appendAttribution": false
        }
      },
